// assets/buildings/sample_hardware_store.building.ron
BuildingSpec(
    name: "Granby Equipment Warehouse",
    version: 1,
    cell_dimensions: (1.2, 1.0, 1.2), // Dimensions in meters per voxel cell
    materials: {
        "brick_outer": MaterialSpec(
            yield_threshold: 4500.0,
            density: 1900.0,
            color: "#8B3E2F",
            drop_on_collapse: true,
        ),
        "reinforced_pillar": MaterialSpec(
            yield_threshold: 18000.0,
            density: 2500.0,
            color: "#4A4E51",
            drop_on_collapse: false,
        ),
        "plate_glass": MaterialSpec(
            yield_threshold: 400.0,
            density: 2200.0,
            color: "#A2D2FF",
            drop_on_collapse: true,
        ),
        "timber_roof": MaterialSpec(
            yield_threshold: 1200.0,
            density: 650.0,
            color: "#855835",
            drop_on_collapse: true,
        ),
    },
    // Grid layers indexed from bottom floor (Y=0) upward
    layers: [
        // Layer 0: Ground Foundation & Pillars
        LayerSpec(
            y_index: 0,
            rows: [
                ["reinforced_pillar", "brick_outer", "brick_outer", "reinforced_pillar"],
                ["brick_outer",       "plate_glass", "plate_glass", "brick_outer"],
                ["brick_outer",       "air",         "air",         "brick_outer"],
                ["reinforced_pillar", "brick_outer", "brick_outer", "reinforced_pillar"],
            ],
        ),
        // Layer 1: Ceiling & Trusses
        LayerSpec(
            y_index: 1,
            rows: [
                ["timber_roof", "timber_roof", "timber_roof", "timber_roof"],
                ["timber_roof", "timber_roof", "timber_roof", "timber_roof"],
                ["timber_roof", "timber_roof", "timber_roof", "timber_roof"],
                ["timber_roof", "timber_roof", "timber_roof", "timber_roof"],
            ],
        ),
    ],
)
